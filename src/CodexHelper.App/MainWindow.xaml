<Window x:Class="CodexHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Helper" Height="820" Width="1280" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}"
        Icon="Assets/CodexHelper.ico">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="84"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,18,12,12" VerticalAlignment="Center">
                    <Image Source="Assets/CodexHelper.png" Width="54" Height="54" Stretch="Uniform" />
                    <StackPanel Margin="10,5,0,0">
                        <TextBlock Text="Codex Helper" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="连接 · 保护 · 迁移" Foreground="#8EA4BE" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="DashboardNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="⌂   总览" Tag="Dashboard" IsChecked="True" Checked="Navigate_Checked"/>
                    <RadioButton x:Name="ConnectionsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="⇄   连接中心" Tag="Connections" Checked="Navigate_Checked"/>
                    <RadioButton x:Name="CollaborationNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="⇋   协作开发" Tag="Collaboration" Checked="Navigate_Checked"/>
                    <RadioButton x:Name="ProjectsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="▣   选择要保护的项目" Tag="Projects" Checked="Navigate_Checked"/>
                    <RadioButton x:Name="SnapshotsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="◷   备份与恢复" Tag="Snapshots" Checked="Navigate_Checked"/>
                    <RadioButton x:Name="MigrationNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="⇅   迁移中心" Tag="Migration" Checked="Navigate_Checked"/>
                    <RadioButton x:Name="HealthNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="♡   健康中心" Tag="Health" Checked="Navigate_Checked"/>
                    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="⚙   设置" Tag="Settings" Checked="Navigate_Checked"/>
                </StackPanel>
                <Border Grid.Row="2" Margin="18,12" BorderBrush="#29415D" BorderThickness="1" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="本地优先 · 秘密加密" Foreground="#C7D3E2" FontSize="11" />
                        <TextBlock x:Name="VersionText" Text="v—" Foreground="#68829E" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="MainScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,22,28,28">
                    <Grid x:Name="DashboardPage">
                        <StackPanel>
                            <TextBlock Text="总览" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="当前连接、数据保护状态与需要处理的问题。" Style="{StaticResource PageSubtitle}" />
                            <UniformGrid Columns="3" Margin="0,0,0,18">
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="当前连接" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="CurrentConnectionText" Text="正在识别…" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="ConnectionDetailText" Text="" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock Text="最近快照" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="LastSnapshotText" Text="尚未备份" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="SnapshotDetailText" Text="请选择备份仓库" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Text="保护项目" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="ProtectedProjectText" Text="0 个" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="ProjectDetailText" Text="添加工作区后自动发现" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="一键保护" Style="{StaticResource SectionTitle}"/><TextBlock Text="增量保护 Codex 关键数据、个人 Skills 和已钉住项目；重复内容不会再次占用空间。不含账号密钥、会话和附件。DSH 数据请在“协作开发 → DeepSeek Harness”页面单独备份。" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,20,0" TextWrapping="Wrap"/></StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="立即保护" Click="BackupNow_Click" MinWidth="130"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="Codex 数据概览" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <DataGrid x:Name="InventoryGrid" IsReadOnly="True" MaxHeight="330">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="数据" Binding="{Binding DisplayName}" Width="2*"/>
                                            <DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="*"/>
                                            <DataGridTextColumn Header="文件" Binding="{Binding FileCount}" Width="*"/>
                                            <DataGridTextColumn Header="大小" Binding="{Binding SizeBytes, Converter={x:Static local:ByteSizeConverter.Instance}}" Width="*" xmlns:local="clr-namespace:CodexHelper.App"/>
                                            <DataGridCheckBoxColumn Header="默认保护" Binding="{Binding IncludedByDefault}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ConnectionsPage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="连接中心" Style="{StaticResource PageTitle}" /><TextBlock Text="统一管理官方账号、原生 Responses API 和 Sub2API。切换前会检查 Codex 进程。" Style="{StaticResource PageSubtitle}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="已保存连接" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="这里管理 Codex 主模型连接，官方账号、原生 Responses API 与 Sub2API 档案在此集中维护。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12"/>
                                <DataGrid x:Name="ConnectionsGrid" IsReadOnly="True" SelectionMode="Extended" MaxHeight="340" SelectionChanged="ConnectionsGrid_SelectionChanged">
                                    <DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="类型" Binding="{Binding DisplayKind}" Width="*"/><DataGridTextColumn Header="身份/地址" Binding="{Binding DisplayTarget}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding DisplayTarget}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="模型" Binding="{Binding Model}" Width="*"/><DataGridCheckBoxColumn Header="活动" Binding="{Binding IsActive}" Width="*"/><DataGridTextColumn Header="额度" Binding="{Binding DisplayQuota}" Width="2*"/><DataGridTextColumn Header="状态" Binding="{Binding StatusMessage}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding StatusMessage}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,12,0,0"><Button x:Name="SwitchConnectionButton" Style="{StaticResource PrimaryButton}" Content="切换到所选连接" Click="SwitchConnection_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="VerifyAccountButton" Style="{StaticResource SecondaryButton}" Content="检测账号/额度" Click="VerifyOfficialAccount_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="TestApiButton" Style="{StaticResource SecondaryButton}" Content="测试 API" Click="TestApi_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="RepairLegacyButton" Style="{StaticResource SecondaryButton}" Content="修复旧 Responses 档案" Click="RepairLegacyResponses_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="DeleteConnectionButton" Style="{StaticResource SecondaryButton}" Content="删除所选连接" Click="DeleteConnection_Click" IsEnabled="False" Margin="0,0,8,0"/><Button Style="{StaticResource SecondaryButton}" Content="安全退出 Codex" Click="StopCodex_Click"/></WrapPanel>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="账号健康详情" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AccountHealthDetailText" Text="选择一个官方账号可查看套餐、额度窗口、重置时间和最近检测历史。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,10"/><WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="刷新此账号" Click="VerifyOfficialAccount_Click" Margin="0,0,8,0"/><Button Style="{StaticResource SecondaryButton}" Content="刷新全部官方账号" Click="VerifyAllOfficialAccounts_Click"/></WrapPanel></StackPanel></Border>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="保存当前官方登录" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="只读取 Codex 已生成的 auth.json，并使用当前 Windows 用户 DPAPI 加密。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,12"/><TextBlock Text="账号名称"/><TextBox x:Name="OfficialLabelBox" Margin="0,5,0,12"/><WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="保存当前登录" Click="SaveOfficial_Click" Margin="0,0,8,0"/><Button Style="{StaticResource SecondaryButton}" Content="准备登录新账号" Click="PrepareLogin_Click"/></WrapPanel></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="保存 API 档案" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="名称"/><TextBox x:Name="ApiLabelBox" Margin="0,5,0,8"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="类型"/><ComboBox x:Name="ApiKindBox" Margin="0,5,0,8" MinHeight="34" SelectedIndex="0"><ComboBoxItem Content="原生 Responses API（切换主模型）" Tag="CustomApi"/><ComboBoxItem Content="Sub2API" Tag="Sub2Api"/></ComboBox></StackPanel></Grid><TextBlock Text="Base URL"/><TextBox x:Name="ApiUrlBox" Margin="0,5,0,4"/><TextBlock Text="可填域名、/v1 或 /responses；软件会自动整理为可用 Responses 地址。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11"/><TextBlock Text="模型"/><TextBox x:Name="ApiModelBox" Margin="0,5,0,8"/><TextBlock Text="API Key（留空表示保留已有 Key）"/><PasswordBox x:Name="ApiKeyBox" Margin="0,5,0,12"/><Button Style="{StaticResource PrimaryButton}" Content="加密保存 API 档案" Click="SaveApi_Click" HorizontalAlignment="Left"/></StackPanel></Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="CollaborationPage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="协作开发" Style="{StaticResource PageTitle}"/><TextBlock Text="集中管理实现执行器（Reasonix / DeepSeek Harness）、状态、模型、权限、执行强度、最近任务与缓存诊断。" Style="{StaticResource PageSubtitle}"/>
                            <WrapPanel Margin="0,0,0,16">
                                <TextBlock Text="实现执行器" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="15" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CollaborationModeBox" Width="240" MinHeight="34" VerticalAlignment="Center" SelectionChanged="CollaborationModeBox_SelectionChanged">
                                    <ComboBoxItem Tag="Off">关闭协作（GPT 独立开发）</ComboBoxItem>
                                    <ComboBoxItem Tag="Reasonix">Reasonix</ComboBoxItem>
                                    <ComboBoxItem Tag="Harness">DeepSeek Harness（预览）</ComboBoxItem>
                                </ComboBox>
                                <TextBlock x:Name="CollaborationModeHintText" Text="切换会保存设置并同步协作规则；旧版已启用 Reasonix 的设备升级后保持 Reasonix。" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Margin="12,0,0,0" TextWrapping="Wrap"/>
                            </WrapPanel>
                            <Grid x:Name="CollaborationOffPanel" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="协作已关闭（GPT 独立开发）" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Codex Helper 不管理任何实现执行器：GPT 直接完成全部实现，不显示执行器检测或协作规则。在上方选择 Reasonix 或 DeepSeek Harness 可启用协作执行。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid x:Name="CollaborationHarnessPanel" Visibility="Collapsed">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="DeepSeek Harness 协作编码" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HarnessModeBadge" Text="协作未开启" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="10,2,0,0" FontSize="12"/></StackPanel>
                                        <TextBlock x:Name="HarnessCollaborationStatusText" Text="协作未开启。点击“开启协作编码”先验证环境（Node/dsh/Web Host/中继），就绪后应用协作规则。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,12,0"/>
                                        <Expander Header="高级环境与诊断（Node/dsh/Host/能力）" Margin="0,10,0,0">
                                            <StackPanel>
                                        <TextBox x:Name="HarnessEnvironmentText" Text="尚未检测。点击“重新检测”检查 Node.js 与 Harness Web Host。" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0" ToolTipService.ShowDuration="60000"/>
                                        <TextBlock Text="仅检测并启动你已有环境中的 Node/Harness，不安装 Node、npm 包或 Harness。可用性由入口与能力探测决定：Node 需 22.19+（LTS）或 24+；dsh 以已知基线 @deepseek-ai/dsh@0.1.0-rc.5 做版本风险提示，入口完整且能力通过时新版本即可用，禁止静默使用 latest。Web Host 仅监听 127.0.0.1，关闭浏览器不会停止任务。当前机器无 Node 是正常降级，可打开官方下载入口。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,8"/>
                                        <TextBlock Text="合同 profile/patch 目录：$DSH_HOME/.agent-presets/codex-contract/（默认 ~/.dsh/.agent-presets/codex-contract/）；不修改用户已有 profile，不覆盖凭据或默认模型。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                                        <WrapPanel>
                                            <Button x:Name="OpenHarnessWebButton" Style="{StaticResource SecondaryButton}" Content="打开 Harness Web" Click="OpenHarnessWeb_Click" Margin="0,0,8,6" IsEnabled="False"/>
                                            <Button x:Name="HarnessRescanButton" Style="{StaticResource SecondaryButton}" Content="重新检测" Click="HarnessRescan_Click" Margin="0,0,8,6"/>
                                            <Button x:Name="StopHarnessHostButton" Style="{StaticResource SecondaryButton}" Content="停止 Helper 启动的 Host" Click="StopHarnessHost_Click" Margin="0,0,8,6"/>
                                            <Button x:Name="ChooseHarnessNodeButton" Style="{StaticResource SecondaryButton}" Content="选择 Node 路径" Click="ChooseHarnessNode_Click" Margin="0,0,8,6"/>
                                            <Button x:Name="ConfigureHarnessStartupButton" Style="{StaticResource PrimaryButton}" Content="一键配置 Codex + Harness" Click="ConfigureHarnessStartup_Click" Margin="0,0,8,6"/>
                                            <Button x:Name="RemoveHarnessStartupButton" Style="{StaticResource SecondaryButton}" Content="移除登录自启动" Click="RemoveHarnessStartup_Click" Margin="0,0,0,6"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="HarnessStartupStatusText" Text="登录自启动尚未检查。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel><Button x:Name="HarnessCollaborationActionButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="开启协作编码" VerticalAlignment="Top" Margin="12,0,0,0" Click="HarnessCollaborationActionButton_Click"/></Grid></Border>
                                    <TabControl Style="{StaticResource HarnessTabControl}">
                                        <TabItem Header="概览与设置" Style="{StaticResource HarnessTabItem}"><StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                                        <TextBlock Text="合同执行设置" FontSize="18" FontWeight="SemiBold"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <TextBlock Text="执行模式" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="HarnessExecutionModeBox" Width="190" Margin="0,0,16,0"><ComboBoxItem Tag="codex-contract">Codex 合同模式（推荐）</ComboBoxItem><ComboBoxItem Tag="standard">Standard</ComboBoxItem><ComboBoxItem Tag="minimal">Minimal</ComboBoxItem><ComboBoxItem Tag="plan">Plan（只规划）</ComboBoxItem></ComboBox>
                                            <TextBlock Text="权限" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="HarnessPermissionModeBox" Width="190" Margin="0,0,16,0"><ComboBoxItem Tag="danger-full-access">完全控制（默认）</ComboBoxItem><ComboBoxItem Tag="workspace-write">仅工作区写入</ComboBoxItem><ComboBoxItem Tag="read-only">只读</ComboBoxItem></ComboBox>
                                            <TextBlock Text="执行强度" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="HarnessExecutionStrengthBox" Width="150"><ComboBoxItem Tag="quick">快速</ComboBoxItem><ComboBoxItem Tag="standard">标准（默认）</ComboBoxItem><ComboBoxItem Tag="deep">深入</ComboBoxItem></ComboBox>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0,0"><CheckBox x:Name="HarnessReuseSessionCheck" Content="仅同一合同接回会话" Margin="0,0,16,0"/><CheckBox x:Name="HarnessAutoStartHostCheck" Content="自动启动本地 Host" Margin="0,0,16,0"/><CheckBox x:Name="HarnessReturnToGptCheck" Content="异常后交还 GPT"/></WrapPanel>
                                        <WrapPanel Margin="0,10,0,0"><Button Style="{StaticResource PrimaryButton}" Content="应用并测试" Click="ApplyHarnessExecutionSettings_Click" Margin="0,0,8,0"/><Button Style="{StaticResource SecondaryButton}" Content="恢复推荐设置" Click="RestoreHarnessRecommendedSettings_Click"/></WrapPanel>
                                        <TextBlock Text="完全控制会跳过 Harness 工具审批，可执行任意命令；仅用于你信任的合同。思考强度由当前模型自动决定，Helper 的执行强度只控制合同范围与检查预算。" TextWrapping="Wrap" Foreground="#B54708" FontSize="11" Margin="0,9,0,0"/>
                                        <TextBlock Text="模型、智能体预设与模型凭据都在 Harness Web 中管理，Helper 不提供模型或思考强度控件（思考强度由模型自动决定）。默认执行模式为 Codex 合同模式：使用 Helper 托管的 codex-contract 预设（基于官方 standard 的完整副本，仅替换 persona 为合同规则），预设不可用时诚实降级 standard。Helper 管理的权限边界与 Reasonix 一致：GPT 规划与验收，Harness 在唯一任务目录内实现；任务正文只从项目内合同文件读取，凭据与 API Key 绝不进入命令行或日志。会话仅在相同任务 ID 与合同指纹（或相同项目且显式声明相同 rootCauseKey 组键）下接回运行中会话；项目历史仅用于展示，绝不作为新合同的上下文来源。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,0"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Content="打开 Harness Web 设置" Click="OpenHarnessWebSettings_Click" Margin="0,0,8,6"/>
                                        </WrapPanel>
                                    </StackPanel></Border>
                                    </StackPanel></TabItem>
                                        <TabItem Header="任务" Style="{StaticResource HarnessTabItem}"><StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                                        <TextBlock Text="Harness 任务中心" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="显示最近 Harness 任务，运行中优先。选择一个任务后，下方操作作用于所选任务；会话 ID 存在时可在 Harness Web 中打开同一任务。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,8" FontSize="12"/>
                                        <TextBlock x:Name="HarnessTaskListHintText" Text="暂无任务" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,6" FontSize="12"/>
                                        <ListBox x:Name="HarnessTaskListBox" MinHeight="72" MaxHeight="230" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HarnessTaskListBox_SelectionChanged"/>
                                        <TextBlock x:Name="HarnessTaskDetailText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="2,8,2,2" Visibility="Collapsed"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Content="刷新" Click="RefreshHarnessTasks_Click" Margin="0,0,8,6"/>
                                            <Button x:Name="StopHarnessTaskButton" Style="{StaticResource SecondaryButton}" Content="停止所选任务" Click="StopHarnessTask_Click" IsEnabled="False" Margin="0,0,8,6"/>
                                            <Button x:Name="CopyHarnessTaskIdButton" Style="{StaticResource SecondaryButton}" Content="复制任务 ID" Click="CopyHarnessTaskId_Click" IsEnabled="False" Margin="0,0,8,6"/>
                                            <Button x:Name="CopyHarnessSessionIdButton" Style="{StaticResource SecondaryButton}" Content="复制会话 ID" Click="CopyHarnessSessionId_Click" IsEnabled="False" Margin="0,0,8,6"/>
                                            <Button x:Name="OpenHarnessTaskDirectoryButton" Style="{StaticResource SecondaryButton}" Content="打开任务目录" Click="OpenHarnessTaskDirectory_Click" IsEnabled="False" Margin="0,0,8,6"/>
                                            <Button x:Name="OpenHarnessTaskInWebButton" Style="{StaticResource SecondaryButton}" Content="在 Harness Web 打开" Click="OpenHarnessTaskInWeb_Click" IsEnabled="False" Margin="0,0,0,6"/>
                                        </WrapPanel>
                                    </StackPanel></Border>
                                    </StackPanel></TabItem>
                                        <TabItem Header="组件与迁移" Style="{StaticResource HarnessTabItem}"><StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                                        <TextBlock Text="组件迁移与配置" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="扫描 DSH Skills、Agent 预设与用户插件的 helper-setup.json 声明，说明每个组件是否可直接使用、缺什么配置及判定依据；可把 DSH 可迁移数据导出为版本化 ZIP，在另一台电脑预览后导入。迁移包不含账号密钥、会话、附件、缓存、日志或依赖树。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,12,0"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="DshRescanButton" Style="{StaticResource SecondaryButton}" Content="重新扫描" Click="RefreshDshComponents_Click" Margin="0,0,8,6"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="导出 DSH 迁移包" Click="ExportDshTransfer_Click" Margin="0,0,8,6"/>
                                            <Button Style="{StaticResource SecondaryButton}" Content="导入 DSH 迁移包" Click="ImportDshTransfer_Click" Margin="0,0,8,6"/>
                                            <Button Style="{StaticResource SecondaryButton}" Content="打开 Harness Web 设置" Click="OpenHarnessWebSettings_Click" Margin="0,0,0,6"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="DshComponentsHintText" Text="尚未扫描。点击“重新扫描”查看 DSH 组件配置状态。" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4" FontSize="12"/>
                                        <ListBox x:Name="DshComponentsList" MinHeight="64" MaxHeight="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="DshComponentsList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding KindDisplay}" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,0"/>
                                                            <TextBlock Text="{Binding Version}" Foreground="{StaticResource SecondaryTextBrush}" Margin="6,0,0,0"/>
                                                            <TextBlock Text="{Binding StatusDisplay}" Margin="10,0,0,0" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DeclarationSourceDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="DshComponentDetailText" Text="选中组件后在此显示配置步骤、缺失字段与判定依据。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="2,8,2,0" Visibility="Collapsed"/>
                                        <TextBlock Text="配置字段只在选中后展开；必须写入 DSH 私有凭据的组件显示缺失字段并打开官方 Harness Web 设置页完成，Helper 不直接解析或改写 .credentials.yaml。导出前可预览类型、内容、文件数与大小；导入先暂存校验（越界、重解析点、损坏与哈希不匹配会被拒绝），默认不覆盖已有文件。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel></Border>
                                    </StackPanel></TabItem>
                                        <TabItem Header="备份与恢复" Style="{StaticResource HarnessTabItem}"><StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                                        <TextBlock Text="DSH 数据保护" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="备份与恢复 DeepSeek Harness 的个人 Skills、Agent 预设、用户配置与用户插件；不包含账号密钥、会话、附件、缓存或 storages。DSH 数据只在本卡片备份，通用“立即备份”不再自动包含 DSH 数据。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,12,0"/>
                                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="备份仓库路径" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="DshRepositoryPathText" Text="尚未设置" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择备份位置" Click="ChooseRepository_Click" VerticalAlignment="Center"/></Grid>
                                        <TextBlock x:Name="DshSnapshotListHintText" Text="尚未设置备份仓库。请选择备份位置后创建 DSH 快照。" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4" FontSize="12"/>
                                        <DataGrid x:Name="DshSnapshotsGrid" IsReadOnly="True" MaxHeight="300" SelectionChanged="DshSnapshotsGrid_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="备份时间" Binding="{Binding CreatedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="2*"/>
                                                <DataGridTextColumn Header="名称" Binding="{Binding Label}" Width="2*"/>
                                                <DataGridTextColumn Header="文件" Binding="{Binding FileCount}" Width="*"/>
                                                <DataGridTextColumn Header="结果" Binding="{Binding Outcome, Converter={StaticResource OutcomeTextConverter}}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="立即备份 DSH" Click="BackupDshNow_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="RestoreDshSnapshotButton" Style="{StaticResource SecondaryButton}" Content="恢复所选 DSH 快照" Click="RestoreDshSnapshot_Click" IsEnabled="False"/>
                                        </WrapPanel>
                                        <TextBlock Text="DSH 快照列表只显示包含 DSH 数据的快照；恢复会先验证完整性并确认目标 DSH Home，已存在的文件不会被覆盖，越界与符号链接/重解析点会被拒绝。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel></Border>
                                    </StackPanel></TabItem>
                                    </TabControl>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="CollaborationReasonixPanel" Visibility="Collapsed">
                                <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GPT + Reasonix 协作编码" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SubagentSettingsStatusText" Text="尚未检查 Reasonix。点击“重新扫描”检查当前环境。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,12,0"/><TextBlock Text="实现类任务按规模三档路由：微任务（≤2 文件 / 约 80 行、低风险、无跨模块接口）由 GPT 直接实现；其余交给单个 Reasonix 合同；仅中大型且含两个独立模块、接口冻结、写集合不重叠、可机械合并时才 Reasonix 并行候选。Reasonix 由仅在任务期间运行的临时进程执行，任务宿主无限等待（无时长上限，仅可手动停止）。关闭 Helper 不会使其常驻，任务结束后临时进程自动退出。Codex 原生子智能体保持关闭，Reasonix 是独立执行器。正在运行的旧 Codex 任务不会实时重载全局指导，Helper 无法强制其改变调度；建议主要阶段完成后新建任务。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,12,0"/><Grid Margin="0,8,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ReasonixEnvironmentText" Text="尚未扫描 Reasonix CLI。" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTipService.ShowDuration="60000"/><Button x:Name="ReasonixRescanButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="重新扫描" Click="ReasonixRescan_Click" Margin="0,0,8,0" VerticalAlignment="Center"/><Button x:Name="ReasonixSelectCliButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="选择 CLI 文件" Click="ReasonixSelectCli_Click" VerticalAlignment="Center"/></Grid></StackPanel><Button x:Name="SubagentSettingsActionButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="开启协作编码" VerticalAlignment="Top" Click="SubagentSettingsActionButton_Click"/></Grid></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="模型与执行策略" FontSize="18" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,12,0,0"><TextBlock Text="Reasonix 默认模型" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ReasonixDefaultModelBox" Width="320" Margin="0,0,8,0" DisplayMemberPath="Id"/><Button Style="{StaticResource SecondaryButton}" Content="应用并测试" Click="ApplyReasonixDefaultModel_Click"/></WrapPanel>
                                <WrapPanel Margin="0,8,0,0"><TextBlock Text="Reasonix 权限" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ReasonixPermissionModeBox" Width="180" SelectedIndex="1" Margin="0,0,8,0"><ComboBoxItem Tag="Safe">安全开发（推荐）</ComboBoxItem><ComboBoxItem Tag="Full">完全权限</ComboBoxItem></ComboBox><Button Style="{StaticResource SecondaryButton}" Content="应用权限" Click="ApplyReasonixPermissionMode_Click" Margin="0,0,8,0"/><Button Style="{StaticResource SecondaryButton}" Content="测试连接" Click="TestReasonixConnection_Click"/></WrapPanel>
                                <WrapPanel Margin="0,8,0,0"><TextBlock Text="执行强度" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ReasonixIntensityBox" Width="180" Margin="0,0,8,0"><ComboBoxItem Tag="auto" IsSelected="True">Auto（自动推断）</ComboBoxItem><ComboBoxItem Tag="fast">Fast（快速修复）</ComboBoxItem><ComboBoxItem Tag="standard">Standard（标准）</ComboBoxItem><ComboBoxItem Tag="strict">Strict（重大交付）</ComboBoxItem></ComboBox><Button Style="{StaticResource SecondaryButton}" Content="保存强度" Click="ApplyReasonixIntensity_Click"/><TextBlock Text="manifest 声明优先；未声明时按合同范围推断。强度是软预算，不是时间上限。" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="8,0,0,0"/></WrapPanel>
                                <WrapPanel Margin="0,8,0,0"><TextBlock Text="并行设置" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/><CheckBox x:Name="AutoSplitCheck" Content="智能拆分" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox x:Name="ParallelIndependentCheck" Content="独立任务并行" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="最大并发" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="MaxConcurrencyBox" Width="56" Margin="0,0,12,0"><ComboBoxItem Tag="1">1</ComboBoxItem><ComboBoxItem Tag="2" IsSelected="True">2</ComboBoxItem><ComboBoxItem Tag="3">3</ComboBoxItem></ComboBox><CheckBox x:Name="AutoWorktreeCheck" Content="自动 worktree" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox x:Name="ConvergeOnBudgetOverrunCheck" Content="超预算收敛" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Style="{StaticResource SecondaryButton}" Content="保存并行设置" Click="ApplyParallelSettings_Click"/></WrapPanel>
                                <TextBlock Text="智能拆分实现类任务；可独立且写集合不重叠时最多按并发数并行；公共文件/依赖/脏文件风险自动串行；Reasonix 执行、GPT 合并验收；不强制每个请求并行。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="8,6,0,0"/>
                                <TextBlock Text="完全权限会跳过 Reasonix 工具审批，可执行任意命令；仅在你信任任务合同时使用。任务宿主无限等待 Reasonix 退出，不设置任务时长上限；可在本页随时停止任务。首次启用或关闭协作后需重新打开 Codex。" TextWrapping="Wrap" Foreground="#B54708" FontSize="11" Margin="0,9,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="并行任务中心" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="同时显示最近 Reasonix 任务，运行中优先；最多同时运行 2 个任务。选择一个任务后，下方操作作用于所选任务。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,8" FontSize="12"/>
                                <WrapPanel x:Name="ReasonixStatsPanel" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ReasonixTasksDiagnosticText" TextWrapping="Wrap" Foreground="#B54708" FontSize="11" Visibility="Collapsed" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ReasonixTaskListHintText" Text="暂无任务" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,6" FontSize="12"/>
                                <ListBox x:Name="ReasonixTaskListBox" MinHeight="72" MaxHeight="250" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ReasonixTaskListBox_SelectionChanged"/>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="刷新进度" Click="RefreshReasonixTasks_Click" Margin="0,0,8,6"/>
                                    <Button x:Name="StopReasonixTaskButton" Style="{StaticResource SecondaryButton}" Content="停止所选任务" Click="StopReasonixTask_Click" IsEnabled="False" Margin="0,0,8,6"/>
                                    <Button x:Name="RetryReasonixTaskButton" Style="{StaticResource SecondaryButton}" Content="重试所选任务" Click="RetryReasonixTask_Click" IsEnabled="False" Margin="0,0,8,6"/>
                                    <Button x:Name="ReturnToCodexTaskButton" Style="{StaticResource SecondaryButton}" Content="返回原 Codex 任务" Click="ReturnToCodexTask_Click" IsEnabled="False" Margin="0,0,8,6"/>
                                    <Button x:Name="CopyReasonixTaskIdButton" Style="{StaticResource SecondaryButton}" Content="复制任务 ID" Click="CopyReasonixTaskId_Click" Margin="0,0,8,6"/>
                                    <Button x:Name="OpenReasonixTaskDirectoryButton" Style="{StaticResource SecondaryButton}" Content="打开任务目录" Click="OpenReasonixTaskDirectory_Click" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <StackPanel x:Name="ReasonixStepsPanel" Visibility="Collapsed"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="缓存与诊断" FontSize="18" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,6"><TextBlock Text="统计范围" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="DeepSeekCacheRangeBox" Width="150" Margin="0,0,8,6" SelectionChanged="DeepSeekCacheRangeBox_SelectionChanged"><ComboBoxItem Tag="24h">24 小时</ComboBoxItem><ComboBoxItem Tag="7d">7 天</ComboBoxItem><ComboBoxItem Tag="14d" IsSelected="True">14 天（默认）</ComboBoxItem><ComboBoxItem Tag="30d">30 天</ComboBoxItem><ComboBoxItem Tag="all">全部</ComboBoxItem></ComboBox><Button Style="{StaticResource SecondaryButton}" Content="刷新缓存统计" Click="RefreshDeepSeekCacheStats_Click" Margin="0,0,8,6"/><Button Style="{StaticResource SecondaryButton}" Content="修复历史统计" Click="BackfillReasonixStats_Click" Margin="0,0,8,6"/></WrapPanel><TextBlock x:Name="BackfillResultText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Visibility="Collapsed" Margin="0,0,0,6"/><TextBlock x:Name="DeepSeekCacheStatsText" Text="点击刷新，读取本机 DeepSeek 会话用量与 Helper 的 Reasonix 任务统计的缓存命中。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/><ComboBox x:Name="DeepSeekReasoningEffortBox" Visibility="Collapsed"><ComboBoxItem Tag="high" IsSelected="True">高</ComboBoxItem></ComboBox><Button x:Name="ApplyDeepSeekReasoningEffortButton" Visibility="Collapsed" Click="ApplyDeepSeekReasoningEffortButton_Click"/></StackPanel></Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ProjectsPage" Visibility="Collapsed"><StackPanel><TextBlock Text="选择要保护的项目" Style="{StaticResource PageTitle}"/><TextBlock Text="先找到你的开发项目，再决定哪些项目需要进入日常备份。" Style="{StaticResource PageSubtitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="从这里查找项目" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="请选择“放着多个项目的上级文件夹”，例如 C:\实用软件开发；这里不存放备份。软件会扫描该目录和第一层子目录。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,10"/><Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WorkspaceRootBox"/><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择项目所在位置" Click="ChooseWorkspace_Click" Margin="10,0,0,0"/></Grid></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="找到的项目" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/><DataGrid x:Name="ProjectsGrid" IsReadOnly="True" SelectionMode="Extended" MaxHeight="360" SelectionChanged="ProjectsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="项目" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="位置" Binding="{Binding Path}" Width="4*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridCheckBoxColumn Header="Git" Binding="{Binding IsGitRepository}" Width="*"/><DataGridCheckBoxColumn Header="AGENTS" Binding="{Binding HasAgentsFile}" Width="*"/><DataGridCheckBoxColumn Header="已加入备份" Binding="{Binding IsProtected}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,0"><Button x:Name="ProtectProjectsButton" Style="{StaticResource PrimaryButton}" Content="加入备份" Click="ProtectProjects_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="UnprotectProjectsButton" Style="{StaticResource SecondaryButton}" Content="不再备份" Click="UnprotectProjects_Click" IsEnabled="False"/></WrapPanel></StackPanel></Border>
                    </StackPanel></Grid>

                    <Grid x:Name="SnapshotsPage" Visibility="Collapsed"><StackPanel><TextBlock Text="备份与恢复" Style="{StaticResource PageTitle}"/><TextBlock Text="把已选择的项目和 Codex 重要数据备份起来；需要时恢复到一个新位置。" Style="{StaticResource PageSubtitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="备份保存位置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="请选择一个专门存放备份的文件夹，例如 D:\CodexHelperBackup；不要选项目目录、CODEX_HOME 或它们的子目录。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,10,4"/><TextBlock x:Name="RepositoryPathText" Text="尚未设置" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择备份位置" Click="ChooseRepository_Click"/></Grid></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="已有备份" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/><DataGrid x:Name="SnapshotsGrid" IsReadOnly="True" MaxHeight="360" SelectionChanged="SnapshotsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="备份时间" Binding="{Binding CreatedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="2*"/><DataGridTextColumn Header="名称" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="文件" Binding="{Binding FileCount}" Width="*"/><DataGridTextColumn Header="总大小" Binding="{Binding TotalBytes, Converter={x:Static local:ByteSizeConverter.Instance}}" Width="*" xmlns:local="clr-namespace:CodexHelper.App"/><DataGridTextColumn Header="本次新增" Binding="{Binding NewStoredBytes, Converter={x:Static local:ByteSizeConverter.Instance}}" Width="*" xmlns:local="clr-namespace:CodexHelper.App"/><DataGridTextColumn Header="结果" Binding="{Binding Outcome, Converter={StaticResource OutcomeTextConverter}}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="立即备份" Click="BackupNow_Click" Margin="0,0,8,0"/><Button x:Name="RestoreSnapshotButton" Style="{StaticResource SecondaryButton}" Content="恢复文件到新位置" Click="RestoreSnapshot_Click" IsEnabled="False"/></WrapPanel><TextBlock Text="快照不含账号密钥、会话和附件；恢复会先验证完整性，已存在的文件不会被覆盖。DSH Skills、Agent 预设、用户配置与插件的备份/恢复请到“协作开发 → DeepSeek Harness”页面。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
                    </StackPanel></Grid>

                    <Grid x:Name="MigrationPage" Visibility="Collapsed"><StackPanel><TextBlock Text="迁移中心" Style="{StaticResource PageTitle}"/><TextBlock Text="批量导出和导入加密 .chbundle；导入默认不覆盖现有数据。" Style="{StaticResource PageSubtitle}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="批量导出" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="可一次导出 Skills、配置、项目、DSH Skills 与插件和全部连接档案。账号令牌与 API Key 会在迁移包内再次独立加密；DSH 内容不含账号密钥、会话和附件。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,14"/><CheckBox x:Name="ExportSkillsCheck" Content="个人 Skills" IsChecked="True" Margin="0,0,0,8"/><CheckBox x:Name="ExportConfigCheck" Content="Codex 配置与 AGENTS" IsChecked="True" Margin="0,0,0,8"/><CheckBox x:Name="ExportProjectsCheck" Content="已保护项目" IsChecked="True" Margin="0,0,0,8"/><CheckBox x:Name="ExportDshCheck" Content="DSH Skills 与插件" IsChecked="True" Margin="0,0,0,8"/><CheckBox x:Name="ExportConnectionsCheck" Content="连接档案（官方账号、API、Sub2API）" IsChecked="True" Margin="0,0,0,14"/><TextBlock Text="迁移口令（至少 10 个字符）"/><PasswordBox x:Name="ExportPasswordBox" Margin="0,5,0,14"/><Button Style="{StaticResource PrimaryButton}" Content="选择位置并批量导出" Click="ExportBundle_Click" HorizontalAlignment="Left"/><Separator Margin="0,16,0,12"/><TextBlock Text="账号 JSON 导出" FontWeight="SemiBold"/><TextBlock Text="选择目标工具：官方 Codex 与 CPA 按名称分别生成 JSON；Sub2API 生成一个可批量导入的 JSON。账号 JSON 包含登录令牌，请只保存到受信任位置。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,8"/><ComboBox x:Name="AccountExportFormatBox" MinHeight="34" SelectedIndex="0" Margin="0,0,0,10"><ComboBoxItem Content="官方 Codex 客户端（名称.json）" Tag="OfficialCodexJson"/><ComboBoxItem Content="CPA Codex（名称.json）" Tag="CpaJson"/><ComboBoxItem Content="Sub2API 批量 JSON（单文件）" Tag="Sub2ApiJson"/></ComboBox><Button Style="{StaticResource SecondaryButton}" Content="选择目录并导出账号 JSON" Click="ExportOfficialJson_Click" HorizontalAlignment="Left"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="批量导入" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="先验证完整性。普通文件导入到新目录；连接档案导入本机保险库且不会自动激活。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,14"/><TextBlock Text="迁移包"/><Grid Margin="0,5,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ImportBundlePathBox" IsReadOnly="True"/><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择" Click="ChooseBundle_Click" Margin="8,0,0,0"/></Grid><TextBlock Text="迁移口令"/><PasswordBox x:Name="ImportPasswordBox" Margin="0,5,0,10"/><TextBlock x:Name="BundlePreviewText" Text="尚未读取迁移包" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/><WrapPanel><Button Style="{StaticResource SecondaryButton}" Content="预览" Click="PreviewBundle_Click" Margin="0,0,8,8"/><Button Style="{StaticResource PrimaryButton}" Content="导入普通文件" Click="ImportBundle_Click" Margin="0,0,8,8"/><Button Style="{StaticResource PrimaryButton}" Content="导入连接档案" Click="ImportConnections_Click" Margin="0,0,0,8"/></WrapPanel><Separator Margin="0,12,0,12"/><TextBlock Text="官方账号 JSON" FontWeight="SemiBold"/><TextBlock Text="可一次选择多个“名称.json”官方登录文件。导入只保存到本机保险库，不会切换当前账号。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/><Button Style="{StaticResource SecondaryButton}" Content="选择多个 JSON 并导入" Click="ImportOfficialJson_Click" HorizontalAlignment="Left"/><Separator Margin="0,12,0,12"/><TextBlock Text="旧工具迁移" FontWeight="SemiBold"/><TextBlock Text="从旧版 account-switcher 与 api-switcher 目录批量导入；不会改变当前登录或配置。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/><Button Style="{StaticResource SecondaryButton}" Content="选择旧数据目录并导入" Click="ImportLegacy_Click" HorizontalAlignment="Left"/></StackPanel></Border>
                        </Grid>
                    </StackPanel></Grid>

                    <Grid x:Name="HealthPage" Visibility="Collapsed"><StackPanel><TextBlock Text="健康中心" Style="{StaticResource PageTitle}"/><TextBlock Text="检查 Codex、凭据、配置和备份仓库，不显示秘密内容。" Style="{StaticResource PageSubtitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="诊断结果" Style="{StaticResource SectionTitle}"/><TextBox x:Name="HealthTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="44" MaxHeight="360" Margin="0,12,0,12"/><Button Style="{StaticResource PrimaryButton}" Content="运行健康检查" Click="RunHealth_Click" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></Grid>

                    <Grid x:Name="SettingsPage" Visibility="Collapsed"><StackPanel><TextBlock Text="设置" Style="{StaticResource PageTitle}"/><TextBlock Text="目录和策略均可配置，不依赖固定盘符。" Style="{StaticResource PageSubtitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Codex 根目录"/><Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CodexRootBox"/><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择" Click="ChooseCodexRoot_Click" Margin="8,0,0,0"/></Grid><CheckBox x:Name="IncludeSessionsCheck" Content="日常快照包含任务与会话" Margin="0,0,0,8"/><CheckBox x:Name="IncludeAttachmentsCheck" Content="日常快照包含附件与上传" Margin="0,0,0,8"/><CheckBox x:Name="IncludeGeneratedCheck" Content="日常快照包含生成图片" Margin="0,0,0,14"/><WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="保存设置并重新扫描" Click="SaveSettings_Click" Margin="0,0,8,0"/><Button Style="{StaticResource SecondaryButton}" Content="重新观看新手引导" Click="ShowTutorial_Click"/></WrapPanel></StackPanel></Border></StackPanel></Grid>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                <Grid Margin="24,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock x:Name="OperationStageText" Text="就绪" FontWeight="SemiBold"/><TextBlock x:Name="OperationMessageText" Text="数据仅保存在本机。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <ProgressBar x:Name="OperationProgressBar" Grid.Column="1" Height="8" VerticalAlignment="Center" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    <Button x:Name="CancelOperationButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="取消" Margin="12,0,0,0" Visibility="Collapsed" Click="CancelOperation_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
