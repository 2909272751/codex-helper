<Window x:Class="CodexHelper.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Helper 新手引导" Width="760" Height="560" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource AppBackgroundBrush}" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="36,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Codex Helper 新手引导" Style="{StaticResource PageTitle}"/><TextBlock x:Name="StepIndicatorText" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="主窗口会自动切换到当前讲解页面，可边看边对照。" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
            <ProgressBar x:Name="GuideProgress" Grid.Column="1" Width="160" Height="8" Minimum="0" Maximum="7" Value="1" VerticalAlignment="Center"/>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#D9E3EF" BorderThickness="1" CornerRadius="12" Padding="28" Margin="0,24,0,18">
            <StackPanel><TextBlock x:Name="StepTitleText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/><TextBlock x:Name="StepSummaryText" FontSize="15" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap" Margin="0,12,0,18"/><Border Background="#F1F6FA" CornerRadius="8" Padding="16"><TextBlock x:Name="StepBodyText" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="24"/></Border><Border Background="#E8F4FA" BorderBrush="#B9DDEA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"><TextBlock x:Name="StepTipText" TextWrapping="Wrap" Foreground="{StaticResource AccentDarkBrush}"/></Border></StackPanel>
        </Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="跳过引导" Click="Skip_Click" Padding="12,8" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Left"/>
            <Button x:Name="PreviousButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="上一步" Click="Previous_Click" Padding="16,9" Margin="0,0,10,0"/>
            <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="下一步" Click="Next_Click" Padding="18,9"/>
        </Grid>
    </Grid>
</Window>
