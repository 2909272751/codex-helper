<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>CodexHelper.Core</RootNamespace>
    <AssemblyName>CodexHelper.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 单元测试需直接覆盖安全边界纯函数（路径规范化/结构校验等），不为此扩大公开 API。 -->
    <InternalsVisibleTo Include="CodexHelper.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- 基础插件实体随 Core 程序集发布（嵌入资源），安装器的四个 publish 输出因此天然携带，
         不依赖开发目录、不需要联网或 npm；部署服务按资源名解包到受管的稳定本地目录。 -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-catalog-fastpath\package.json"
                      LogicalName="CodexHelper.BasePlugins.dsh-catalog-fastpath.package.json" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-catalog-fastpath\cordis.patch.yml"
                      LogicalName="CodexHelper.BasePlugins.dsh-catalog-fastpath.cordis.patch.yml" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-catalog-fastpath\index.js"
                      LogicalName="CodexHelper.BasePlugins.dsh-catalog-fastpath.index.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-catalog-fastpath\client.js"
                      LogicalName="CodexHelper.BasePlugins.dsh-catalog-fastpath.client.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-model-vision-bridge\package.json"
                      LogicalName="CodexHelper.BasePlugins.dsh-model-vision-bridge.package.json" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-model-vision-bridge\cordis.patch.yml"
                      LogicalName="CodexHelper.BasePlugins.dsh-model-vision-bridge.cordis.patch.yml" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-model-vision-bridge\index.js"
                      LogicalName="CodexHelper.BasePlugins.dsh-model-vision-bridge.index.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-model-vision-bridge\client.js"
                      LogicalName="CodexHelper.BasePlugins.dsh-model-vision-bridge.client.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-browser-compat\package.json"
                      LogicalName="CodexHelper.BasePlugins.dsh-browser-compat.package.json" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-browser-compat\cordis.patch.yml"
                      LogicalName="CodexHelper.BasePlugins.dsh-browser-compat.cordis.patch.yml" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\attachments\dsh-profile-plugins\dsh-browser-compat\index.js"
                      LogicalName="CodexHelper.BasePlugins.dsh-browser-compat.index.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
