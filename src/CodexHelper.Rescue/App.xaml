<Application x:Class="CodexHelper.Rescue.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="RescueWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Accent" Color="#087EA4"/>
        <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Application.Resources>
</Application>

