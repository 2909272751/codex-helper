<Window x:Class="CodexHelper.Rescue.RescueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Helper Rescue" Width="880" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA" Icon="Assets/CodexHelper.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Source="Assets/CodexHelper.png" Width="64" Height="64"/>
            <StackPanel Margin="14,4,0,0"><TextBlock Text="Codex Helper 救援工具" FontSize="25" FontWeight="SemiBold" Foreground="#10213A"/><TextBlock Text="主程序不可用时，独立打开快照并恢复到安全新目录。" Foreground="#68768A" Margin="0,6,0,0"/></StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RepositoryBox" MinHeight="36" Padding="8" IsReadOnly="True"/><Button Grid.Column="1" Content="选择备份仓库" Click="ChooseRepository_Click" Margin="10,0,0,0"/></Grid>
        </Border>
        <DataGrid Grid.Row="2" x:Name="SnapshotGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="White" BorderBrush="#DCE4EE" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding CreatedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="2*"/><DataGridTextColumn Header="名称" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="文件" Binding="{Binding FileCount}" Width="*"/><DataGridTextColumn Header="总字节" Binding="{Binding TotalBytes}" Width="*"/><DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="*"/></DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="请选择备份仓库。" FontWeight="SemiBold"/><ProgressBar x:Name="Progress" Height="7" Margin="0,7,20,0" Visibility="Collapsed"/></StackPanel><Button Grid.Column="1" Content="恢复所选快照到新目录" Click="Restore_Click"/></Grid>
    </Grid>
</Window>

